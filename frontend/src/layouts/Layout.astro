---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'B2T · 把书变成有声书。支持 EPUB / TXT / PDF，按章节合成语音，导出带章节的 MP3 / M4B。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <script is:inline>
      // 首屏渲染前确定主题，避免闪烁
      (function () {
        var t = localStorage.getItem('b2t-theme');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <style is:global>
      :root {
        color-scheme: light;
        --ink: #1c1a17;
        --ink-soft: #6b6660;
        --bg: #faf8f4;
        --card: #ffffff;
        --line: #e8e2d9;
        --accent: #b3541e;
        --accent-soft: #f6e8dd;
        --success: #2e7d32;
        --success-bg: #e6f3e7;
        --danger: #c62828;
        --muted: #b0a99f;
        --overlay: rgba(0, 0, 0, .3);
        --shadow: rgba(0, 0, 0, .12);
      }
      [data-theme="dark"] {
        color-scheme: dark;
        --ink: #e9e4dc;
        --ink-soft: #a09a90;
        --bg: #16130f;
        --card: #221e19;
        --line: #3b352d;
        --accent: #d97b45;
        --accent-soft: #38271a;
        --success: #66bb6a;
        --success-bg: #1c2a18;
        --danger: #e57373;
        --muted: #6f6a62;
        --overlay: rgba(0, 0, 0, .6);
        --shadow: rgba(0, 0, 0, .45);
      }
      * { box-sizing: border-box; margin: 0; }
      body {
        font-family: "Songti SC", "Noto Serif CJK SC", "Source Han Serif SC", Georgia, serif;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.7;
      }
      a { color: var(--accent); text-decoration: none; }
      .container { max-width: 880px; margin: 0 auto; padding: 0 20px; }
      header.site {
        border-bottom: 1px solid var(--line);
        background: var(--bg);
        position: sticky; top: 0; z-index: 10;
      }
      header.site .container {
        display: flex; align-items: center; justify-content: space-between;
        padding-top: 14px; padding-bottom: 14px;
      }
      .logo { font-size: 20px; font-weight: 700; color: var(--ink); letter-spacing: 1px; }
      .logo span { color: var(--accent); }
      nav.site a { margin-left: 20px; color: var(--ink-soft); font-size: 15px; }
      nav.site a:hover { color: var(--accent); }
      nav.site a.cta {
        color: #fff; background: var(--accent); padding: 6px 16px; border-radius: 6px;
      }
      main { padding: 40px 0 80px; }
      footer.site {
        border-top: 1px solid var(--line); color: var(--ink-soft);
        font-size: 13px; padding: 24px 0; text-align: center;
      }
      .btn {
        display: inline-block; background: var(--accent); color: #fff;
        padding: 10px 24px; border-radius: 6px; font-size: 16px; border: none;
        cursor: pointer; font-family: inherit;
      }
      .btn.secondary { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
      .btn:disabled { opacity: .5; cursor: not-allowed; }
      .crumbs {
        display: flex; align-items: center; gap: 10px;
        font-size: 14px; color: var(--ink-soft); margin-bottom: 18px;
      }
      .crumbs a { color: var(--ink-soft); }
      .crumbs a:hover { color: var(--accent); }
      .crumbs .sep { opacity: .4; }
      .crumbs .cur {
        color: var(--ink); font-weight: 600;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .theme-toggle {
        background: none; border: 1px solid var(--line); color: var(--ink-soft);
        width: 30px; height: 30px; border-radius: 50%; margin-left: 20px;
        cursor: pointer; font-size: 14px; line-height: 1;
      }
      .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
      /* 表单控件：背景是 var(--bg)/var(--card)，必须显式给文字色，否则暗色下黑字不可见 */
      input, select, textarea {
        color: var(--ink);
        caret-color: var(--accent);
      }
      .card {
        background: var(--card); border: 1px solid var(--line);
        border-radius: 10px; padding: 24px;
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="container">
        <a class="logo" href="/">B<span>2</span>T</a>
        <nav class="site">
          <a href="/help">使用帮助</a>
          <a href="/app" class="cta">开始制作</a>
          <button id="theme-toggle" class="theme-toggle" aria-label="切换夜间模式" title="切换夜间模式">☾</button>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="container">B2T · 把书变成有声书</div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        function sync() { btn.textContent = document.documentElement.dataset.theme === 'dark' ? '☀' : '☾'; }
        btn.addEventListener('click', function () {
          var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('b2t-theme', next);
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
